{
  "name": "hologram",
  "version": "0.4.0",
  "private": true,
  "description": "Desktop hand-tracking overlay: crystal-blue hand landmarks drawn over the whole desktop.",
  "main": "dist/main.js",
  "scripts": {
    "fetch-model": "node scripts/fetch-model.mjs",
    "build": "node scripts/build.mjs",
    "start": "npm run fetch-model && npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dist:win": "npm run fetch-model && npm run build && electron-builder --win --publish never",
    "pack:win": "npm run fetch-model && npm run build && electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "electron-updater": "^6.8.9",
    "koffi": "^3.3.2"
  },
  "author": "Ismael Fern\u00e1ndez",
  "build": {
    "appId": "com.hologram.app",
    "productName": "Hologram",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/**",
      "node_modules/koffi/package.json",
      "node_modules/koffi/index.*",
      "node_modules/koffi/indirect.*",
      "node_modules/koffi/src/koffi/**/*.{js,cjs,json}",
      "node_modules/@koromix/koffi-win32-x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Hologram.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hologram",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Hologram-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "podselxd",
        "repo": "Hologram-",
        "releaseType": "release"
      }
    ]
  }
}
